# UMD server 모드 (AP-01) — .env.server 로 복사해서 사용

# ===== 이미지 / 포트 =====
IMAGE_TAG=latest
APP_PORT=8081
# actuator(health, prometheus, 인증 없음) 노출 주소. 기본 127.0.0.1 = 호스트 내부 전용
MANAGEMENT_BIND=127.0.0.1
MANAGEMENT_HOST_PORT=8091

# ===== 실행 =====
APP_ENV=PROD
# 응답 Stream: d94:umd:rep:{UMD_INSTANCE_ID}. server 마다 고유
UMD_INSTANCE_ID=umd-ap01
UMD_REQUEST_TIMEOUT=30s
# UMD 자체 오류 응답에만 붙일 CORS Origin (쉼표 구분). 백엔드 CORS 허용 목록과 동일하게
UMD_CORS_ORIGINS=

# ===== AP-02 Redis (필수) =====
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ===== 인증 (필수) =====
# d94-query 와 동일한 Base64 인코딩 키
JWT_SECRET_KEY=
