# UMD local 모드 (Home PC) — .env.delap 으로 복사해서 사용
# 라우팅은 config/routes.yml (config/routes.example.yml 참고)

# ===== 이미지 / 포트 =====
IMAGE_TAG=latest
# actuator 만 호스트 내부(127.0.0.1)에 노출. 앱 포트는 publish 하지 않는다
MANAGEMENT_HOST_PORT=8092

# ===== 실행 =====
APP_ENV=HOME
# Redis Consumer 이름. 집 PC 마다 고유
UMD_INSTANCE_ID=umd-delap-01

# ===== AP-02 Redis (필수, 아웃바운드 연결) =====
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ===== 백엔드 네트워크 =====
# 게이트웨이(cloud-gateway) 컨테이너가 붙어 있는 기존 docker 네트워크 이름 (external, 이 compose 는 만들지 않음)
# 확인: docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' <게이트웨이 컨테이너>
SHARED_NETWORK_NAME=befw-cloud-network

# local 모드는 JWT 를 검증하지 않으므로 JWT_SECRET_KEY 가 필요 없다 (토큰은 그대로 백엔드로 전달)
